# SMRITI Environment Configuration Template
# DO NOT COMMIT REAL SECRETS TO SOURCE CONTROL

# Environment & Server
ENVIRONMENT=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# Database Configuration (PostgreSQL with SQLite fallback)
# For local PostgreSQL:
# DATABASE_URL=postgresql+psycopg2://smriti_user:smriti_password@localhost:5432/smriti_db
# For local SQLite fallback:
DATABASE_URL=sqlite:///./smriti.db

# JWT Authentication
JWT_SECRET=smriti-development-jwt-secret-key-change-in-production-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Local Demo Server Configuration
DEMO_HOST=0.0.0.0
DEMO_PORT=8080
