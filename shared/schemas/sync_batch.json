{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SyncBatchPayload",
  "type": "object",
  "properties": {
    "patientId": { "type": "string" },
    "deviceId": { "type": "string" },
    "sentAt": { "type": "string", "format": "date-time" },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "localId": { "type": "string" },
          "entityType": { "type": "string", "enum": ["GameSessions", "Reminders", "ReminderEvents", "Routines", "Memories"] },
          "operation": { "type": "string", "enum": ["INSERT", "UPDATE", "DELETE"] },
          "payload": { "type": "object" },
          "clientTimestamp": { "type": "string", "format": "date-time" }
        },
        "required": ["localId", "entityType", "operation", "payload", "clientTimestamp"]
      }
    }
  },
  "required": ["patientId", "items", "sentAt"]
}
